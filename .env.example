# Gepato-AI v2.0 — muhit o'zgaruvchilari.
# Serverda bu faylni qo'lda to'ldirmang: deploy/install.sh tasodifiy sirlar bilan .env yaratadi.
# Lokal ishga tushirish: cp .env.example .env && docker compose up --build  ->  http://127.0.0.1:3200
ENVIRONMENT=development
DEBUG=false
# production'da kamida 32 belgi, tasodifiy (openssl rand -hex 32) — aks holda API ishga tushmaydi
SECRET_KEY=change-me-in-production
POSTGRES_PASSWORD=local-dev-only
# Birinchi admin (ishga tushishda yo'q bo'lsa yaratiladi; keyin parol .env'dan qayta yozilmaydi)
BOOTSTRAP_ADMIN_EMAIL=admin@gepato.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
# AI (ixtiyoriy). Bepul: https://aistudio.google.com/apikey (bo'lsa Gemini ishlatiladi)
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
# Frontend boshqa domenda bo'lsa (odatda kerak emas): ALLOWED_ORIGINS=https://a.uz
ALLOWED_ORIGINS=
